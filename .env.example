# Nusxa oling: cp .env.example .env
# .env HECH QACHON git ga tushmaydi (.gitignore da).

# ---------- Baza ----------
# Docker Compose ishlatsangiz — quyidagi uchtasi yetarli, DATABASE_URL
# compose tomonidan avtomatik yig'iladi.
POSTGRES_DB=mirzohid_db
POSTGRES_USER=miniuser
POSTGRES_PASSWORD=

# Docker'siz (lokal) ishlatganda buni to'ldiring:
DATABASE_URL=postgresql+asyncpg://miniuser:PAROL@localhost:5432/mirzohid_db

# ---------- Telegram ----------
BOT_TOKEN=
# Vergul bilan: 5081646633,123456789
ADMIN_IDS=

# ---------- Domen / Web ----------
# Caddy shu domenga sertifikat oladi.
DOMAIN=mirzohid.uz
# Telegram webhook va Mini App shu manzilga uradi. HTTPS majburiy.
PUBLIC_BASE_URL=https://mirzohid.uz
# Frontend Next rewrite orqali ishlagani uchun CORS odatda kerak emas.
CORS_ORIGINS=https://mirzohid.uz

# Production'da webhook; lokalda false qoldiring — bot polling bilan ishlaydi.
USE_WEBHOOK=false

# ---------- Sirlar ----------
# Ikkalasini ham albatta yangilang:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
WEBHOOK_SECRET=

# ---------- Eslatma vaqti (Asia/Tashkent) ----------
REMINDER_HOUR=9
REMINDER_MINUTE=0

# ---------- Zaxira (ixtiyoriy) ----------
BACKUP_BOT_TOKEN=
BACKUP_SEND_CHAT_ID=
